{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "orquestrador",
  "permissions": {
    "allow": [
      "Bash",
      "Write",
      "Edit",
      "Skill",
      "Agent(subagent-analista-requisitos)",
      "Agent(subagent-criador-tarefas)",
      "Agent(subagent-desenvolvedor)",
      "Agent(subagent-revisor-codigo)",
      "Agent(subagent-qa)"
    ],
    "ask": [
      "Agent(subagent-arquiteto)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/fabrica-guard.mjs\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/slack-notify.mjs\"" }
        ]
      }
    ]
  }
}
